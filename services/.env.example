# Copier vers .env (jamais versionné). Toutes les clés sont facultatives en développement.
ENV=dev
DATABASE_URL=postgresql+psycopg://radarao:radarao@localhost:5432/radarao
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=change-me

# IA : sans clé, mettre AI_MODE=offline (embeddings lexicaux locaux, analyse désactivée)
AI_MODE=live
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# Lakehouse Databricks (facultatif; sans lui, repli sur PostgreSQL) — voir docs/adr/ADR-005
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_WAREHOUSE_ID=
DATABRICKS_CATALOG=workspace
DATABRICKS_SCHEMA=radarao

# Stockage : s3 (MinIO en local) ou local
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Tâches : celery | inline (dev sans Redis) | none (tests)
TASK_MODE=celery
EMAIL_BACKEND=console
